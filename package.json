{
  "name": "mtaa-quiz-battle",
  "version": "1.1.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "start:tunnel": "expo start --tunnel",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "validate:data": "node scripts/validate-data.mjs",
    "admin:review": "node scripts/admin-review.mjs",
    "check:contrast": "node scripts/check-contrast.mjs",
    "check": "npm run typecheck && npm run validate:data && npm run check:contrast && npm run test:ci",
    "release:check": "node scripts/release-check.mjs",
    "test": "jest --forceExit",
    "test:watch": "jest --watch --forceExit",
    "test:ci": "jest --forceExit --ci --coverage"
  },
  "jest": {
    "preset": "jest-expo",
    "testEnvironment": "node",
    "testMatch": [
      "**/__tests__/**/*.test.[jt]s?(x)"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?)|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|@unimodules/.*|unimodules|sentry-expo|native-base|react-native-svg)"
    ],
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/src/$1"
    },
    "collectCoverageFrom": [
      "src/utils/gameLogic.ts",
      "src/storage/storage.ts",
      "src/data/questions.ts"
    ]
  },
  "expo": {
    "install": {
      "exclude": ["@expo/config-plugins"]
    }
  },
  "dependencies": {
    "@expo/config-plugins": "~57.0.0",
    "@expo/ngrok": "^4.1.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "babel-preset-expo": "~57.0.0",
    "expo": "^57.0.9",
    "expo-asset": "~57.0.12",
    "expo-audio": "~57.0.3",
    "expo-constants": "~57.0.12",
    "expo-font": "~57.0.1",
    "expo-haptics": "~57.0.1",
    "expo-in-app-purchases": "^14.5.0",
    "expo-linear-gradient": "~57.0.1",
    "expo-linking": "~57.0.6",
    "expo-notifications": "~57.0.12",
    "expo-router": "~57.0.14",
    "expo-sharing": "~57.0.13",
    "expo-splash-screen": "~57.0.7",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-google-mobile-ads": "^16.5.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-view-shot": "5.1.0",
    "react-native-web": "^0.21.0",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@react-native/jest-preset": "^0.86.2",
    "@types/jest": "29.5.14",
    "@types/node": "^24.13.3",
    "@types/react": "~19.2.10",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.4",
    "ts-jest": "^29.4.9",
    "typescript": "~6.0.3"
  },
  "private": true
}
