{
  "name": "mtaa-quiz-battle",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "start:tunnel": "expo start --tunnel",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "validate:data": "node scripts/validate-data.mjs",
    "admin:review": "node scripts/admin-review.mjs",
    "check:contrast": "node scripts/check-contrast.mjs",
    "check": "npm run typecheck && npm run validate:data && npm run check:contrast && npm run test:ci",
    "release:check": "node scripts/release-check.mjs",
    "test": "jest --forceExit",
    "test:watch": "jest --watch --forceExit",
    "test:ci": "jest --forceExit --ci --coverage"
  },
  "jest": {
    "preset": "jest-expo",
    "testEnvironment": "node",
    "testMatch": [
      "**/__tests__/**/*.test.[jt]s?(x)"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?)|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|@unimodules/.*|unimodules|sentry-expo|native-base|react-native-svg)"
    ],
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/src/$1"
    },
    "collectCoverageFrom": [
      "src/utils/gameLogic.ts",
      "src/storage/storage.ts",
      "src/data/questions.ts"
    ]
  },
  "dependencies": {
    "@expo/ngrok": "^4.1.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/bottom-tabs": "^7.3.10",
    "@react-navigation/native": "^7.1.6",
    "@react-navigation/native-stack": "^7.3.10",
    "expo": "~55.0.26",
    "expo-av": "~15.1.7",
    "expo-font": "~55.0.8",
    "expo-haptics": "~55.0.14",
    "expo-in-app-purchases": "^14.5.0",
    "expo-linear-gradient": "~55.0.14",
    "expo-notifications": "~55.0.23",
    "expo-router": "~55.0.16",
    "expo-sharing": "~55.0.20",
    "expo-splash-screen": "~55.0.21",
    "expo-status-bar": "~55.0.6",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-native": "0.83.6",
    "react-native-google-mobile-ads": "^16.3.3",
    "react-native-reanimated": "4.2.1",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "~4.23.0",
    "react-native-view-shot": "4.0.3",
    "react-native-web": "^0.21.0",
    "react-native-worklets": "^0.7.4"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@types/jest": "29.5.14",
    "@types/react": "~19.2.10",
    "jest": "^29.7.0",
    "jest-expo": "~55.0.18",
    "ts-jest": "^29.4.9",
    "typescript": "^5.3.3"
  },
  "private": true
}
